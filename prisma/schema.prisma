// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Taxonomy: Hub -> Client -> Workstream -> Project
// ---------------------------------------------------------------------------

model Hub {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients Client[]
}

model Client {
  id        String   @id @default(cuid())
  name      String
  hubId     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hub                    Hub                     @relation(fields: [hubId], references: [id], onDelete: Cascade)
  workstreams            Workstream[]
  masterServiceAgreement MasterServiceAgreement?
  rateCards              RateCard[]
  // Client-specific SOW Template variants only — the GLOBAL baseline has a
  // null clientId and is not part of this relation.
  sowTemplates           SOWTemplate[]

  @@unique([hubId, name])
}

model Workstream {
  id        String   @id @default(cuid())
  name      String
  clientId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projects Project[]

  @@unique([clientId, name])
}

model Project {
  id           String @id @default(cuid())
  name         String
  workstreamId String

  // Raw brief as ingested at Stage 1 (task 4.1/4.2) — parsed to plain text
  // regardless of source format (docx/pdf/pptx/pasted text).
  briefRawText  String?
  briefFileName String?
  briefFileType String?

  // Denormalized convenience field for Stage Tracker / list views — the
  // source of truth for per-stage state is still ProjectStageStatus.
  currentStageNumber Int @default(1)

  // Project summary details, shown on the project page header. Set via the
  // summary edit form, independent of the Set-Up Checklist's tick-boxes
  // (task 7.4) — not populated by any agent.
  jobCode              String?
  kickOffDate          DateTime?
  targetCompletionDate DateTime?
  projectManagerId     String?

  // Optional Rate Card selection (task: "Client-scoped selection at project
  // creation"). Must always belong to this Project's own Workstream's Client
  // — enforced in the Server Actions that set it, not just by this FK.
  rateCardId String?

  // Pins the specific RateCardVersion in effect when it was selected, so a
  // later version upload (which disables the previous one) can't silently
  // change this Project's pricing. Nullable: not yet backfillable for every
  // historical selection and not yet written by any Server Action — that's
  // phase 2. rateCardId is kept alongside it (not replaced) since existing
  // code still reads/writes it; phase 2 decides whether to retire it.
  rateCardVersionId String?

  // Optional SOW Template selection, set when a PM starts SOW development.
  // Must be the global baseline or belong to this Project's own Client —
  // enforced in the Server Action that sets it, not just by this FK. Only
  // records the selection; the SOW-generation agent that consumes it is
  // future/Level 3 scope.
  sowTemplateId String?

  // Pins the specific SOWTemplateVersion in effect when it was selected —
  // same rationale/nullability as rateCardVersionId above.
  sowTemplateVersionId String?

  // Optional Master Service Agreement link. Nullable: no historical source
  // exists to backfill which MSA a pre-existing project was created under,
  // and no Server Action writes this yet — phase 2 makes it a required
  // selection for new projects going forward, but the column itself stays
  // nullable at the DB level so existing rows remain valid.
  masterServiceAgreementId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workstream             Workstream              @relation(fields: [workstreamId], references: [id], onDelete: Cascade)
  projectManager         User?                   @relation(fields: [projectManagerId], references: [id], onDelete: SetNull)
  rateCard               RateCard?               @relation(fields: [rateCardId], references: [id], onDelete: SetNull)
  rateCardVersion        RateCardVersion?        @relation(fields: [rateCardVersionId], references: [id], onDelete: SetNull)
  sowTemplate            SOWTemplate?            @relation(fields: [sowTemplateId], references: [id], onDelete: SetNull)
  sowTemplateVersion     SOWTemplateVersion?     @relation(fields: [sowTemplateVersionId], references: [id], onDelete: SetNull)
  masterServiceAgreement MasterServiceAgreement? @relation(fields: [masterServiceAgreementId], references: [id], onDelete: SetNull)
  stageStatuses          ProjectStageStatus[]
  documents              Document[]
  checklistItems         ChecklistItem[]
  touchpointNotes        TouchpointNote[]
  knowledgeItems         KnowledgeItem[]
  capabilities           ProjectCapability[]
  estimateBrief          EstimateBrief?
  estimates              Estimate[]
  sow                    SOW?

  @@unique([workstreamId, name])
}

// ---------------------------------------------------------------------------
// Client-level commercial documents (MSAs, Rate Cards, SOW Templates) — a
// shared "named document has many Versions, exactly one current" pattern.
// Uploading a new version disables whichever version was previously current;
// reverting re-enables an old version and disables the current one. Nothing
// is ever deleted. Write access (new documents, new versions, reverts) is
// restricted to the ClientEngagement role, enforced server-side in the
// Server Actions that mutate them, not just in the UI — see
// src/lib/permissions.ts. PM-facing selectors only ever see/use each
// document's current (ENABLED) version; disabled versions stay visible in
// the admin-facing history view for the record.
// ---------------------------------------------------------------------------

enum VersionStatus {
  ENABLED
  DISABLED
}

// The MSA is a single, unnamed document per Client (there's only ever "the"
// MSA for a Client, unlike Rate Cards or SOW Templates which can have
// several named/variant documents) — hence the clientId unique constraint.
model MasterServiceAgreement {
  id        String   @id @default(cuid())
  clientId  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client   Client                          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  versions MasterServiceAgreementVersion[]
  projects Project[]
}

model MasterServiceAgreementVersion {
  id                       String        @id @default(cuid())
  masterServiceAgreementId String
  versionNumber            Int
  fileName                 String
  fileBytes                Bytes
  extractedText            String
  effectiveFrom            DateTime
  effectiveTo              DateTime?
  status                   VersionStatus @default(ENABLED)
  uploadedById             String?
  uploadedAt               DateTime      @default(now())

  masterServiceAgreement MasterServiceAgreement @relation(fields: [masterServiceAgreementId], references: [id], onDelete: Cascade)
  uploadedBy             User?                  @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@unique([masterServiceAgreementId, versionNumber])
}

model RateCard {
  id         String    @id @default(cuid())
  clientId   String
  name       String
  // Nullable: rate cards often carry multiple currencies (per role) within a
  // single file — currency selection happens when a user consumes the rate
  // card, not at upload time, so it's not always meaningful to record one
  // value here.
  currency   String?
  // Set to retire this named Rate Card from end-user selectors without
  // touching its version-currency (ENABLED/DISABLED) state — a distinct
  // lever from superseding a version, per the Rule 3 audit gap.
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  client   Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  versions RateCardVersion[]
  projects Project[]
}

model RateCardVersion {
  id            String        @id @default(cuid())
  rateCardId    String
  versionNumber Int
  fileName      String
  fileBytes     Bytes
  extractedText String
  effectiveFrom DateTime
  effectiveTo   DateTime?
  status        VersionStatus @default(ENABLED)
  uploadedById  String?
  uploadedAt    DateTime      @default(now())

  rateCard   RateCard  @relation(fields: [rateCardId], references: [id], onDelete: Cascade)
  uploadedBy User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  projects   Project[]

  // Structured role/level/rate rows, parsed lazily (once, then cached) the
  // first time this version is used by an Estimate — see
  // rate-card-line-item-agent.ts. Purely additive read of extractedText
  // above; nothing about the upload flow changes.
  lineItems        RateCardLineItem[]
  estimates        Estimate[]
  estimateVersions EstimateVersion[]

  @@unique([rateCardId, versionNumber])
}

enum SOWTemplateScope {
  GLOBAL
  CLIENT_SPECIFIC
}

model SOWTemplate {
  id         String           @id @default(cuid())
  name       String
  scope      SOWTemplateScope
  // Null for GLOBAL templates (including the seeded baseline); required for
  // CLIENT_SPECIFIC variants.
  clientId   String?
  isBaseline Boolean          @default(false)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  client      Client?              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  versions    SOWTemplateVersion[]
  projects    Project[]
  sowVersions SOWVersion[]
}

model SOWTemplateVersion {
  id            String        @id @default(cuid())
  sowTemplateId String
  versionNumber Int
  fileName      String
  fileBytes     Bytes
  extractedText String
  status        VersionStatus @default(ENABLED)
  uploadedById  String?
  uploadedAt    DateTime      @default(now())

  sowTemplate SOWTemplate  @relation(fields: [sowTemplateId], references: [id], onDelete: Cascade)
  uploadedBy  User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  projects    Project[]
  sowVersions SOWVersion[]

  @@unique([sowTemplateId, versionNumber])
}

// ---------------------------------------------------------------------------
// Stages (1-10 modeled; 1-5 active for MVP, 6-10 placeholders)
// ---------------------------------------------------------------------------

enum StageType {
  LINEAR
  RECURRING
}

model Stage {
  id     String    @id @default(cuid())
  number Int       @unique
  name   String
  type   StageType @default(LINEAR)

  stageStatuses ProjectStageStatus[]
}

enum StageStatusValue {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
}

model ProjectStageStatus {
  id          String           @id @default(cuid())
  projectId   String
  stageId     String
  status      StageStatusValue @default(NOT_STARTED)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage   Stage   @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([projectId, stageId])
}

// ---------------------------------------------------------------------------
// Documents & versions (typed per artifact; versioned at stage transitions)
// ---------------------------------------------------------------------------

enum DocumentType {
  CLARIFICATION_EMAIL
  POSITION_DOCUMENT
  CHECKLIST
  DRAFT_SCOPE_DOCUMENT
  DELIVERABLES_SERVICES_DOCUMENT
}

model Document {
  id        String       @id @default(cuid())
  projectId String
  type      DocumentType
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  project  Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions DocumentVersion[]

  @@unique([projectId, type])
}

model DocumentVersion {
  id            String   @id @default(cuid())
  documentId    String
  versionNumber Int
  // Structured fields for this artifact type (see src/types for the shape
  // matching each DocumentType) — agents write this, never free text.
  content       Json
  stageNumber   Int
  createdById   String?
  createdAt     DateTime @default(now())

  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([documentId, versionNumber])
}

// ---------------------------------------------------------------------------
// End-of-Phase-1: which MAP capability teams a project needs estimates from,
// and the downloadable brief prepared for them. Additive to the Stage 1-5
// pipeline — never gates Stage 2 (specialist consultation). The 12
// capabilities are a fixed list (see src/lib/mapCapabilities.ts for the
// human-readable reference content each maps to); "confirmed" is a single
// live source of truth per Project, editable at any time, independent of
// how it was populated (manual pick or accepted AI suggestion).
// ---------------------------------------------------------------------------

enum Capability {
  CLIENT_ENGAGEMENT_AND_DELIVERY
  CUSTOMER_AND_BUSINESS_STRATEGY
  BUSINESS_ARCHITECTURE
  AI_INNOVATION_AND_ENABLEMENT
  INSIGHTS_AND_OPTIMIZATION
  EXPERIENCE_STRATEGY
  EXPERIENCE_DESIGN
  DATA_SOLUTION_CONSULTING
  TECH_SOLUTION_CONSULTING
  TECH_AND_DATA
  MEDIA_SOLUTION_CONSULTING
  MARKETING_OPERATIONS
}

model ProjectCapability {
  id         String     @id @default(cuid())
  projectId  String
  capability Capability
  createdAt  DateTime   @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, capability])
}

// One EstimateBrief per Project; each "Prepare the estimate brief" run adds
// a new EstimateBriefVersion rather than overwriting — mirrors the MSA/Rate
// Card/SOW Template document+version split, minus their ENABLED/DISABLED
// revert mechanic, which this doesn't need (nothing here is ever superseded
// by re-uploading an old file — only by generating a new one).
model EstimateBrief {
  id        String   @id @default(cuid())
  projectId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions EstimateBriefVersion[]
}

model EstimateBriefVersion {
  id              String       @id @default(cuid())
  estimateBriefId String
  versionNumber   Int
  fileName        String
  // Rendered .docx bytes, downloaded as-is — see estimate-brief-docx.ts.
  fileBytes       Bytes
  // Structured content behind the .docx (project overview + one section per
  // capability) — kept alongside the rendered file for the in-app review
  // step, same rationale as DocumentVersion.content.
  content         Json
  // Snapshot of which capabilities were confirmed at generation time — a
  // frozen historical record, not a live relation, so a plain Postgres enum
  // array rather than another join table.
  capabilities    Capability[]
  createdById     String?
  createdAt       DateTime     @default(now())

  estimateBrief EstimateBrief @relation(fields: [estimateBriefId], references: [id], onDelete: Cascade)
  createdBy     User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([estimateBriefId, versionNumber])
}

// One SOW per Project, mirroring EstimateBrief/EstimateBriefVersion exactly
// (see that model's comment) — append-only versions, no ENABLED/DISABLED/
// revert mechanic. Unlike EstimateBrief, each version also pins which
// SOWTemplate/SOWTemplateVersion actually informed it: a PM can change the
// Project's live template selection (startSowDevelopmentAction)
// independently of regenerating, so a past SOWVersion needs its own frozen
// record of what it was drafted against, not a live read of
// Project.sowTemplateVersionId — same rationale as EstimateVersion locking
// to one rateCardVersionId for its whole life.
model SOW {
  id        String   @id @default(cuid())
  projectId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions SOWVersion[]
}

model SOWVersion {
  id                   String   @id @default(cuid())
  sowId                String
  versionNumber        Int
  fileName             String
  // Rendered .docx bytes, downloaded as-is — see sow-docx.ts.
  fileBytes            Bytes
  // { coverDetails: SowCoverDetails, body: SOWDocumentContent } — deterministic
  // cover-details half (client/dates/commercials, never agent-authored) plus
  // the agent-drafted narrative half, kept together as one self-contained
  // historical snapshot — see src/types/sow.ts.
  content              Json
  // Frozen snapshot of which template/version this draft was generated
  // against — see the model comment above. Nullable/SetNull: removing a
  // template later shouldn't invalidate the historical SOWVersion record.
  sowTemplateId        String?
  sowTemplateVersionId String?
  createdById          String?
  createdAt            DateTime @default(now())

  sow                SOW                 @relation(fields: [sowId], references: [id], onDelete: Cascade)
  sowTemplate        SOWTemplate?        @relation(fields: [sowTemplateId], references: [id], onDelete: SetNull)
  sowTemplateVersion SOWTemplateVersion? @relation(fields: [sowTemplateVersionId], references: [id], onDelete: SetNull)
  createdBy          User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([sowId, versionNumber])
}

// ---------------------------------------------------------------------------
// Build The Estimate: versioned, rate-card-matched, priced estimate tracks.
// An Estimate is a project-scoped working artifact (like the Draft Scope
// Document) — not a client-level commercial master like MSA/RateCard/
// SOWTemplate — so it follows the simpler immutable/append-only versioning
// pattern (EstimateBrief/EstimateBriefVersion above), not the
// ENABLED/DISABLED+revert one. A Project can have several Estimate tracks in
// parallel, each locked for its whole life to one specific RateCardVersion
// (not just a RateCard — pricing needs one version's actual lines).
//
// RoleResolution is this codebase's first "pause and ask a human" model:
// resolvedAt nullability IS the pending/resolved signal, matching the
// existing nullable-timestamp-as-flag idiom (ChecklistItem.completedAt,
// RateCard.archivedAt) rather than inventing a new status enum.
// ---------------------------------------------------------------------------

enum RateType {
  HOURLY
  DAILY
  WEEKLY
}

// Structured role/level/rate rows for a RateCardVersion, since
// RateCardVersion itself only stores a raw file + one extractedText blob
// (see FB-001) — parsed lazily by rate-card-line-item-agent.ts the first
// time a RateCardVersion is locked to an Estimate, then cached here so it's
// never re-parsed for that version again. Read-only derivative of
// extractedText; never written by the rate card upload flow itself.
model RateCardLineItem {
  id                String   @id @default(cuid())
  rateCardVersionId String
  role              String
  level             String?
  rateType          RateType
  rate              Decimal  @db.Decimal(12, 2)
  currency          String
  createdAt         DateTime @default(now())

  rateCardVersion   RateCardVersion    @relation(fields: [rateCardVersionId], references: [id], onDelete: Cascade)
  suggestedFor      RoleResolution[]   @relation("RoleResolutionSuggestedLine")
  resolvedFor       RoleResolution[]   @relation("RoleResolutionResolvedLine")
  estimateLineItems EstimateLineItem[]

  @@index([rateCardVersionId])
}

model Estimate {
  id                String   @id @default(cuid())
  projectId         String
  label             String
  rateCardVersionId String
  createdById       String?
  createdAt         DateTime @default(now())

  project          Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rateCardVersion  RateCardVersion           @relation(fields: [rateCardVersionId], references: [id], onDelete: Restrict)
  createdBy        User?                     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  capabilityInputs EstimateCapabilityInput[]
  roleResolutions  RoleResolution[]
  versions         EstimateVersion[]
}

enum EstimateInputSource {
  PASTE
  FILE
}

// An append-only record of one raw paste/upload batch of estimate content —
// nothing more. Name predates a redesign where capability moved to
// RoleResolution (a batch can contain roles for several different
// capability teams at once, classified individually by AI on extraction —
// see estimate-role-extraction-agent.ts); there is no longer a "revise this
// capability's input in place" concept, each submission just appends.
model EstimateCapabilityInput {
  id         String @id @default(cuid())
  estimateId String

  source         EstimateInputSource
  rawContent     String
  sourceFileName String?
  addedById      String?
  addedAt        DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  estimate        Estimate         @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  addedBy         User?            @relation(fields: [addedById], references: [id], onDelete: SetNull)
  roleResolutions RoleResolution[]
}

enum RoleMatchType {
  NO_MATCH
  ROLE_ONLY
  ROLE_AND_LEVEL
}

// Tracks every role the matching agent could not fully and confidently
// resolve to one specific rate-card line (role-only confidence is never
// enough by itself, even with an exact role-name match — see
// src/lib/estimateMatching.ts). resolvedAt: DateTime? null = pending,
// blocks saveEstimateVersionAction; set = resolved, either by the agent
// (high-confidence ROLE_AND_LEVEL match, resolvedById null) or by a PM
// confirming/overriding (resolvedById set).
model RoleResolution {
  id                        String        @id @default(cuid())
  estimateId                String
  estimateCapabilityInputId String
  // Classified per role by the extraction agent — always exactly one of the
  // fixed 12, never a free-text "Other" (unlike the old batch-level tag this
  // replaced). See estimate-role-extraction-agent.ts.
  capability                Capability
  rawRoleText               String
  extractedRole             String
  extractedLevel            String?
  extractedQuantity         Decimal       @db.Decimal(10, 2)
  extractedUnit             String
  matchType                 RoleMatchType
  confidence                Float
  suggestedRateCardLineId   String?
  resolvedRateCardLineId    String?
  resolvedById              String?
  resolvedAt                DateTime?
  createdAt                 DateTime      @default(now())

  estimate                Estimate                @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  estimateCapabilityInput EstimateCapabilityInput @relation(fields: [estimateCapabilityInputId], references: [id], onDelete: Cascade)
  suggestedRateCardLine   RateCardLineItem?       @relation("RoleResolutionSuggestedLine", fields: [suggestedRateCardLineId], references: [id], onDelete: SetNull)
  resolvedRateCardLine    RateCardLineItem?       @relation("RoleResolutionResolvedLine", fields: [resolvedRateCardLineId], references: [id], onDelete: SetNull)
  resolvedBy              User?                   @relation(fields: [resolvedById], references: [id], onDelete: SetNull)
  resultingLineItems      EstimateLineItem[]

  @@index([estimateId, resolvedAt])
}

// Immutable, append-only — "latest" = highest versionNumber, no status
// field, no revert (see the section header above). Created only once every
// pending RoleResolution for this Estimate is cleared.
model EstimateVersion {
  id                   String       @id @default(cuid())
  estimateId           String
  versionNumber        Int
  rateCardVersionId    String
  // Frozen historical snapshot, not a live relation — same rationale as
  // EstimateBriefVersion.capabilities.
  capabilitiesIncluded Capability[]
  totalValue           Decimal      @db.Decimal(14, 2)
  currency             String
  // Auto-generated one-line summary (e.g. "3 capabilities: CEAD, ED, MO") —
  // plain code (src/services/pricing/estimate-pricing.ts), never agent
  // output.
  description          String
  fileName             String
  // Rendered .docx bytes, downloaded as-is — see estimate-document-docx.ts.
  fileBytes            Bytes
  // Structured content behind the .docx, same rationale as
  // EstimateBriefVersion.content.
  content              Json
  createdById          String?
  createdAt            DateTime     @default(now())

  estimate        Estimate           @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  rateCardVersion RateCardVersion    @relation(fields: [rateCardVersionId], references: [id], onDelete: Restrict)
  createdBy       User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lineItems       EstimateLineItem[]

  @@unique([estimateId, versionNumber])
}

// Belongs to exactly one version, never mutated after creation. Pricing
// (rate * quantity = feeSubtotal) is always deterministic code — see
// src/services/pricing/estimate-pricing.ts — never LLM output.
model EstimateLineItem {
  id                 String     @id @default(cuid())
  estimateVersionId  String
  capability         Capability
  role               String
  level              String?
  rateType           RateType
  rate               Decimal    @db.Decimal(12, 2)
  quantity           Decimal    @db.Decimal(10, 2)
  unit               String
  feeSubtotal        Decimal    @db.Decimal(14, 2)
  // Audit traceability back to the human decision and rate-card row that
  // produced this fee — never used to mutate this row after creation.
  roleResolutionId   String?
  rateCardLineItemId String?
  createdAt          DateTime   @default(now())

  estimateVersion  EstimateVersion   @relation(fields: [estimateVersionId], references: [id], onDelete: Cascade)
  rateCardLineItem RateCardLineItem? @relation(fields: [rateCardLineItemId], references: [id], onDelete: SetNull)
  roleResolution   RoleResolution?   @relation(fields: [roleResolutionId], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------------------
// Manual checklist (interactive tick-box state, distinct from the versioned
// CHECKLIST Document artifact that generated the initial items)
// ---------------------------------------------------------------------------

model ChecklistItem {
  id          String    @id @default(cuid())
  projectId   String
  label       String
  isComplete  Boolean   @default(false)
  // Freeform detail (e.g. job code, folder URL) — always editable regardless
  // of isComplete; someone may know the value before ticking the box.
  detailText  String?
  order       Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Freeform human touchpoint notes (client clarification reply, specialist
// review feedback) that feed the next agent step
// ---------------------------------------------------------------------------

enum TouchpointNoteType {
  CLARIFICATION_REPLY
  SPECIALIST_REVIEW
}

model TouchpointNote {
  id                   String             @id @default(cuid())
  projectId            String
  type                 TouchpointNoteType
  content              String
  // Which MAP capability team this note is about — SPECIALIST_REVIEW notes
  // only, always null for CLARIFICATION_REPLY. Null `capability` with a set
  // `otherCapabilityLabel` means the submitter picked "Other" and typed a
  // custom team name, same convention as DeliverablesServicesDocument's own
  // services.other.label.
  capability           Capability?
  otherCapabilityLabel String?
  createdById          String?
  createdAt            DateTime           @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------------------
// Ad-hoc knowledge base (independent of Stage, always available)
// ---------------------------------------------------------------------------

enum KnowledgeItemType {
  DOCUMENT
  NOTE
}

model KnowledgeItem {
  id               String            @id @default(cuid())
  projectId        String
  type             KnowledgeItemType
  title            String
  content          String
  originalFileName String?
  uploadedById     String?
  uploadedAt       DateTime          @default(now())

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------------------
// Users & roles
// ---------------------------------------------------------------------------

enum UserRole {
  CLIENT_ENGAGEMENT
  DELIVERY
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  documentVersions               DocumentVersion[]
  touchpointNotes                TouchpointNote[]
  knowledgeItems                 KnowledgeItem[]
  projectsManaged                Project[]
  masterServiceAgreementVersions MasterServiceAgreementVersion[]
  rateCardVersions               RateCardVersion[]
  sowTemplateVersions            SOWTemplateVersion[]
  estimateBriefVersions          EstimateBriefVersion[]
  estimatesCreated               Estimate[]
  estimateCapabilityInputsAdded  EstimateCapabilityInput[]
  roleResolutionsResolved        RoleResolution[]
  estimateVersionsCreated        EstimateVersion[]
  sowVersionsCreated             SOWVersion[]
}
