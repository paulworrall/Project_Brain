# Neon Postgres connection string
# Neon dashboard -> your project -> Connection Details (use the pooled connection string)
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Anthropic API key -> console.anthropic.com -> API Keys
ANTHROPIC_API_KEY="sk-ant-..."

# NextAuth session encryption secret -> generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-generated-secret"

# Base URL of the app (http://localhost:3000 in dev)
NEXTAUTH_URL="http://localhost:3000"
